# Copy this to .env and fill in your values.
# Never commit .env to git.

# ══════════════════════════════════════════════════════
#  LLM PROVIDER
#  Choose one: openai | anthropic | groq | gemini
# ══════════════════════════════════════════════════════
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini          # optional model override

# ── Anthropic Claude ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5  # optional model override

# ── Groq (free tier available) ────────────────────────
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.1-8b-instant   # optional model override

# ── Google Gemini (free tier available) ───────────────
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash      # optional model override

# ══════════════════════════════════════════════════════
#  TIGERGRAPH GraphRAG SERVICE
#  Deployed via: ./scripts/setup_graphrag.sh
# ══════════════════════════════════════════════════════
GRAPHRAG_BASE_URL=http://localhost:80
GRAPHRAG_GRAPH=MyGraph
GRAPHRAG_USER=tigergraph
GRAPHRAG_PASS=tigergraph

# Retriever: hybrid (default) | community | sibling
GRAPHRAG_RETRIEVER=hybrid

# Retrieval tuning (override graphrag_config defaults)
GRAPHRAG_TOP_K=5
GRAPHRAG_NUM_HOPS=2

# ══════════════════════════════════════════════════════
#  BASIC RAG (ChromaDB)
# ══════════════════════════════════════════════════════
EMBED_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ══════════════════════════════════════════════════════
#  INGESTION
# ══════════════════════════════════════════════════════
CHUNK_SIZE=500         # tokens per chunk
OVERLAP_SIZE=50        # token overlap between chunks

# ══════════════════════════════════════════════════════
#  SETUP
# ══════════════════════════════════════════════════════
GRAPHRAG_INSTALL_DIR=./graphrag_service
